@model List<SuperCartMVC.Models.CartItem>
@{ Layout = null; }
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mi Lista de la Compra — SuperCart</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
  <style>
  :root {
    --orange: #FF6B35; --orange-dark: #D94F1A; --yellow: #FFD166; --teal: #2EC4B6;
    --bg: #13151C; --bg2: #1E2130; --bg3: #272C3E; --border: #363C54;
    --text: #F0EDE8; --text-dim: #9BA3BE; --text-muted: #717899;
    --header-bg: rgba(19,21,28,0.93); --shadow: 0 2px 16px rgba(0,0,0,0.45);
  }
  html[data-theme="light"] {
    --orange: #D4510A; --orange-dark: #B53D05; --yellow: #8F6B00; --teal: #0E8A84;
    --bg: #F4F6FB; --bg2: #FFFFFF; --bg3: #ECEEF7; --border: #CDD1E8;
    --text: #1A1D2E; --text-dim: #444968; --text-muted: #6B7299;
    --header-bg: rgba(255,255,255,0.93); --shadow: 0 2px 16px rgba(0,0,0,0.10);
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }

  html, body {
  scrollbar-width: none;
  -ms-overflow-style: none;
  overflow-x: hidden;
  }
  
  html::-webkit-scrollbar,
  body::-webkit-scrollbar {
    display: none;
  }

  body { background: var(--bg); color: var(--text); font-family: 'DM Sans', sans-serif; min-height: 100vh; }
  header { padding: 0.75rem 1rem; display: flex; align-items: center; gap: 0.6rem; border-bottom: 1px solid var(--border); position: sticky; top: 0; background: var(--header-bg); backdrop-filter: blur(12px); z-index: 100; }
  .logo-icon { width: 36px; height: 36px; flex-shrink: 0; }
  .logo-text { font-family: 'Syne', sans-serif; font-size: 1.4rem; font-weight: 800; color: var(--orange); }
  .logo-text span { color: var(--text); }
  .btn-back { background: transparent; border: 1px solid var(--border); border-radius: 10px; padding: 0.45rem 0.85rem; color: var(--text-dim); font-family: 'DM Sans', sans-serif; font-size: 0.83rem; cursor: pointer; text-decoration: none; transition: border-color 0.2s; white-space: nowrap; }
  .btn-back:hover { border-color: var(--orange); color: var(--text); }
  .header-right { margin-left: auto; display: flex; gap: 0.5rem; align-items: center; }
  .theme-btn { background: var(--bg3); border: 1px solid var(--border); border-radius: 8px; padding: 0.35rem 0.55rem; font-size: 1rem; cursor: pointer; line-height: 1; transition: background 0.2s; flex-shrink: 0; }
  .theme-btn:hover { background: var(--border); }
  .page { max-width: 780px; margin: 0 auto; padding: 1.5rem 0.75rem 4rem; }
  h1 { font-family: 'Syne', sans-serif; font-size: 1.6rem; font-weight: 800; margin-bottom: 0.3rem; }
  .subtitle { color: var(--text-dim); font-size: 0.88rem; margin-bottom: 1.5rem; }
  .empty { text-align: center; padding: 3.5rem 1rem; color: var(--text-muted); }
  .empty .icon { font-size: 2.5rem; margin-bottom: 0.8rem; }
  .empty h3 { font-family: 'Syne', sans-serif; font-size: 1.1rem; color: var(--text-dim); margin-bottom: 0.35rem; }
  .cart-list { display: flex; flex-direction: column; gap: 0.65rem; margin-bottom: 1.5rem; }
  .cart-row { background: var(--bg2); border: 1px solid var(--border); border-radius: 14px; display: flex; align-items: center; gap: 0.75rem; padding: 0.7rem 0.85rem; transition: border-color 0.2s; }
  .cart-img { width: 52px; height: 52px; object-fit: contain; background: #fff; border-radius: 8px; padding: 3px; flex-shrink: 0; }
  .cart-img-placeholder { width: 52px; height: 52px; background: var(--bg3); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; flex-shrink: 0; }
  .cart-info { flex: 1; min-width: 0; }
  .cart-market { font-size: 0.62rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; color: var(--teal); }
  .cart-name { font-size: 0.84rem; color: var(--text); line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cart-unit { font-size: 0.68rem; color: var(--text-muted); }
  .cart-price { font-family: 'Syne', sans-serif; font-size: 1rem; font-weight: 700; color: var(--orange); flex-shrink: 0; min-width: 54px; text-align: right; }
  .qty-wrap { display: flex; align-items: center; gap: 0.35rem; flex-shrink: 0; }
  .qty-btn { width: 26px; height: 26px; border-radius: 6px; border: 1px solid var(--border); background: var(--bg3); color: var(--text); cursor: pointer; font-size: 0.95rem; display: flex; align-items: center; justify-content: center; transition: border-color 0.15s; }
  .qty-btn:hover { border-color: var(--orange); color: var(--orange); }
  .qty-val { min-width: 22px; text-align: center; font-size: 0.88rem; font-weight: 600; }
  .btn-delete { background: transparent; border: 1px solid var(--border); border-radius: 8px; padding: 0.28rem 0.5rem; color: var(--text-muted); font-size: 0.83rem; cursor: pointer; transition: all 0.15s; flex-shrink: 0; }
  .btn-delete:hover { border-color: #e24b4a; color: #e24b4a; }
  .summary { background: var(--bg2); border: 1.5px solid var(--border); border-radius: 16px; padding: 1.2rem 1.4rem; display: flex; flex-direction: column; gap: 0.7rem; }
  .summary-title { font-family: 'Syne', sans-serif; font-size: 0.95rem; font-weight: 700; margin-bottom: 0.2rem; }
  .summary-row { display: flex; justify-content: space-between; font-size: 0.85rem; color: var(--text-dim); }
  .summary-total { display: flex; justify-content: space-between; font-family: 'Syne', sans-serif; font-size: 1.2rem; font-weight: 700; color: var(--orange); padding-top: 0.55rem; border-top: 1px solid var(--border); }
  .btn-clear { margin-top: 0.4rem; background: transparent; border: 1px solid var(--border); border-radius: 10px; padding: 0.55rem 1rem; color: var(--text-muted); font-family: 'DM Sans', sans-serif; font-size: 0.83rem; cursor: pointer; transition: all 0.15s; width: 100%; }
  .btn-clear:hover { border-color: #e24b4a; color: #e24b4a; }
  .btn-route { background: var(--bg2); border: 1.5px solid var(--teal); border-radius: 10px; padding: 0.55rem 1rem; color: var(--teal); font-family: 'DM Sans', sans-serif; font-size: 0.83rem; cursor: pointer; transition: all 0.15s; width: 100%; margin-top: 0.4rem; display: flex; align-items: center; justify-content: center; gap: 0.5rem; }
  .btn-route:hover { background: rgba(46,196,182,0.1); }
  .gm-style .gm-style-iw-c { background: #1A1A1C !important; border-radius: 10px !important; box-shadow: 0 4px 16px rgba(0,0,0,0.6) !important; padding: 0 !important; }
  .gm-style .gm-style-iw-d { overflow: hidden !important; }
  .gm-style .gm-style-iw-tc::after, .gm-style .gm-style-iw-t::after { background: #1A1A1C !important; }
  .gm-style .gm-ui-hover-effect { display: none !important; }
  #cartRouteModal { display: none; position: fixed; inset: 0; z-index: 9000; background: rgba(0,0,0,0.85); align-items: center; justify-content: center; padding: 0.75rem; }
  #cartRouteModal.open { display: flex; }
  .route-modal-box { background: var(--bg2); border: 1px solid var(--border); border-radius: 16px; width: 100%; max-width: 860px; max-height: 95vh; display: flex; flex-direction: column; overflow: hidden; }
  .route-modal-header { display: flex; align-items: center; justify-content: space-between; padding: 0.85rem 1.1rem; border-bottom: 1px solid var(--border); flex-shrink: 0; }
  .route-modal-header h2 { font-family:'Syne',sans-serif; font-size:0.92rem; font-weight:700; color:var(--orange); margin:0; }
  #cartRouteMap { width:100%; height:260px; flex-shrink:0; }
  #cartRouteStatus { padding:0.85rem 1.1rem; font-size:0.81rem; color:var(--text-dim); text-align:center; }
  #cartRouteInfo { padding: 0.65rem 1rem 0; overflow-y: auto; flex: 1; min-height: 60px; scrollbar-width: none; -ms-overflow-style: none; }
  #cartRouteInfo::-webkit-scrollbar { display: none; }
  .route-step { display:flex; align-items:flex-start; gap:0.65rem; padding:0.55rem 0; border-bottom:1px solid var(--border); font-size:0.8rem; color:var(--text); line-height:1.4; }
  .route-step:last-child { border-bottom:none; }
  .route-step-num { background:var(--orange); color:#fff; width:22px; height:22px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:0.68rem; font-weight:700; flex-shrink:0; }
  .cart-route-summary { display:flex; gap:0.75rem; padding:0.65rem 1.1rem; background:var(--bg3); border-top:1px solid var(--border); font-size:0.8rem; flex-shrink:0; flex-wrap:wrap; }
  .cart-route-summary span { color:var(--text-dim); }
  .cart-route-summary strong { color:var(--orange); margin-left:3px; }

  @@media (max-width: 480px) {
    header { padding: 0.65rem 0.75rem; }
    .logo-text { font-size: 1.05rem; }
    h1 { font-size: 1.35rem; text-align: center; }
    .cart-row { gap: 0.5rem; padding: 0.6rem 0.7rem; }
    .cart-img, .cart-img-placeholder { width: 44px; height: 44px; }
    .cart-name { font-size: 0.8rem; }
    .qty-btn { width: 24px; height: 24px; font-size: 0.88rem; }
    #cartRouteMap { height: 200px; }
  }

  /* PRODUCT PANEL */
  .product-panel { position: fixed; inset: 0; z-index: 300; display: flex; pointer-events: none; }
  .product-panel.open { pointer-events: all; }
  .panel-backdrop { position: absolute; inset: 0; background: rgba(0,0,0,0); transition: background 0.3s; cursor: pointer; }
  .product-panel.open .panel-backdrop { background: rgba(0,0,0,0.6); }
  .panel-drawer { position: absolute; right: 0; top: 0; bottom: 0; width: min(580px, 100vw); background: var(--bg2); border-left: 1px solid var(--border); display: flex; flex-direction: column; transform: translateX(100%); transition: transform 0.35s cubic-bezier(0.4,0,0.2,1); overflow: hidden; }
  .product-panel.open .panel-drawer { transform: translateX(0); }
  .panel-header { padding: 1.2rem 1.5rem; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 1rem; flex-shrink: 0; }
  .panel-close { background: var(--bg3); border: 1px solid var(--border); border-radius: 8px; color: var(--text-dim); font-size: 1rem; width: 32px; height: 32px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: border-color 0.15s; flex-shrink: 0; }
  .panel-close:hover { border-color: var(--orange); color: var(--text); }
  .panel-title { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 1rem; flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .panel-body { flex: 1; overflow-y: auto; padding: 1.5rem; display: flex; flex-direction: column; gap: 1.2rem; scrollbar-width: none; }
  .panel-body::-webkit-scrollbar { display: none; }
  .panel-product-top { display: flex; gap: 1rem; align-items: flex-start; }
  .panel-img-wrap { width: 100px; height: 100px; background: #fff; border-radius: 12px; overflow: hidden; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
  .panel-img-wrap img { width: 100%; height: 100%; object-fit: contain; padding: 0.5rem; }
  .panel-product-info { flex: 1; display: flex; flex-direction: column; gap: 0.4rem; }
  .panel-market { font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1.2px; color: var(--teal); }
  .panel-name { font-family: 'Syne', sans-serif; font-size: 1.1rem; font-weight: 700; line-height: 1.3; }
  .panel-avg { display: flex; align-items: center; gap: 0.8rem; }
  .panel-avg-big { font-family: 'Syne', sans-serif; font-size: 2.8rem; font-weight: 800; color: var(--yellow); line-height: 1; }
  .panel-avg-right { display: flex; flex-direction: column; gap: 0.25rem; }
  .panel-stars { display: flex; gap: 2px; }
  .pstar { font-size: 1.1rem; color: var(--text-muted); }
  .pstar.filled { color: var(--yellow); }
  .panel-count { font-size: 0.78rem; color: var(--text-muted); }
  .panel-dist { display: flex; flex-direction: column; gap: 0.3rem; }
  .panel-dist-row { display: flex; align-items: center; gap: 0.4rem; font-size: 0.72rem; color: var(--text-muted); }
  .panel-bar-wrap { flex: 1; height: 5px; background: var(--bg3); border-radius: 3px; overflow: hidden; }
  .panel-bar-fill { height: 100%; background: var(--yellow); border-radius: 3px; transition: width 0.5s ease; }
  .panel-form-title { font-family: 'Syne', sans-serif; font-size: 0.9rem; font-weight: 700; margin-bottom: 0.6rem; }
  .panel-star-picker { display: flex; gap: 6px; margin-bottom: 0.8rem; }
  .panel-star { font-size: 1.6rem; cursor: pointer; color: var(--text-muted); transition: color 0.1s, transform 0.1s; user-select: none; }
  .panel-star.filled { color: var(--yellow); }
  .panel-star:hover { transform: scale(1.15); }
  .panel-textarea { width: 100%; background: var(--bg3); border: 1.5px solid var(--border); border-radius: 10px; padding: 0.65rem 0.9rem; color: var(--text); font-family: 'DM Sans', sans-serif; font-size: 0.88rem; resize: vertical; min-height: 75px; outline: none; margin-bottom: 0.75rem; }
  .panel-textarea:focus { border-color: var(--orange); }
  .panel-textarea::placeholder { color: var(--text-muted); }
  .panel-btn-submit { background: var(--orange); border: none; border-radius: 8px; padding: 0.55rem 1.2rem; color: white; font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.85rem; cursor: pointer; transition: background 0.15s; }
  .panel-btn-submit:hover { background: var(--orange-dark); }
  .panel-btn-submit:disabled { background: var(--bg3); color: var(--text-muted); cursor: not-allowed; }
  .panel-success { display: none; background: rgba(46,196,182,0.1); border: 1px solid rgba(46,196,182,0.3); border-radius: 8px; padding: 0.5rem 0.9rem; font-size: 0.82rem; color: var(--teal); margin-bottom: 0.6rem; }
  .panel-auth-prompt { background: var(--bg3); border: 1px dashed var(--border); border-radius: 10px; padding: 1rem; text-align: center; font-size: 0.85rem; color: var(--text-dim); }
  .panel-auth-prompt a { color: var(--orange); text-decoration: none; font-weight: 600; }
  .panel-review { border-top: 1px solid var(--border); padding: 0.9rem 0; display: flex; flex-direction: column; gap: 0.35rem; }
  .panel-review-header { display: flex; align-items: center; gap: 0.6rem; }
  .panel-avatar { width: 30px; height: 30px; border-radius: 50%; background: var(--bg3); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 0.78rem; font-weight: 600; color: var(--orange); flex-shrink: 0; }
  .panel-reviewer-email { font-size: 0.78rem; color: var(--text-dim); flex: 1; }
  .panel-reviewer-date { font-size: 0.68rem; color: var(--text-muted); }
  .panel-review-stars { display: flex; gap: 1px; }
  .prstar { font-size: 0.78rem; color: var(--text-muted); }
  .prstar.filled { color: var(--yellow); }
  .panel-review-comment { font-size: 0.83rem; color: var(--text-dim); line-height: 1.5; padding-left: 0.5rem; border-left: 2px solid var(--border); }
  .panel-no-reviews { text-align: center; color: var(--text-muted); font-size: 0.85rem; padding: 1.5rem 0; }
  .panel-spinner { width: 24px; height: 24px; border: 2px solid var(--border); border-top-color: var(--orange); border-radius: 50%; animation: spin 0.7s linear infinite; margin: 2rem auto; }
  @@keyframes spin { to { transform: rotate(360deg); } }
  @@media (max-width: 560px) {
    header { flex-wrap: wrap; padding: 0.5rem 0.75rem; }
    .header-right { margin-left: 0; width: 100%; justify-content: center; }
  }
</style>
  <script src="https://maps.googleapis.com/maps/api/js?key=@(Configuration["GoogleMaps:ApiKey"])&libraries=places&language=es&region=ES&callback=initCartMaps" async defer></script>
</head>
<body>
  <header>
    <svg class="logo-icon" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M4 10 Q4 5 9 5 L15 5 L15 14" stroke="#FF6B35" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      <rect x="6" y="14" width="30" height="19" rx="5" fill="#FF6B35"/>
      <line x1="6" y1="24" x2="36" y2="24" stroke="rgba(255,255,255,0.18)" stroke-width="1"/>
      <circle cx="37" cy="8" r="7.5" fill="#2EC4B6"/>
      <text x="37" y="12" font-family="sans-serif" font-size="9" font-weight="700" fill="white" text-anchor="middle">€</text>
      <circle cx="14" cy="38.5" r="4.5" fill="#2EC4B6"/>
      <circle cx="14" cy="38.5" r="2" fill="white" opacity=".85"/>
      <circle cx="29" cy="38.5" r="4.5" fill="#2EC4B6"/>
      <circle cx="29" cy="38.5" r="2" fill="white" opacity=".85"/>
    </svg>
    <div class="logo-text">Super<span>Cart</span></div>
    <div class="header-right">
      <button id="themeBtn" class="theme-btn" onclick="toggleTheme()" title="Cambiar tema">☀️</button>
      <a href="/" class="btn-back">← Volver al comparador</a>
    </div>
  </header>

  <div class="page">
    <h1>🛒 Lista de la compra</h1>

    @if (!Model.Any())
    {
      <div class="empty">
        <div class="icon">🛒</div>
        <h3>Tu lista está vacía</h3>
        <p>Busca productos y pulsa el icono del carrito para añadirlos aquí.</p>
      </div>
    }
    else
    {
      <p class="subtitle">@Model.Sum(c => c.Quantity) artículo@(Model.Sum(c => c.Quantity) != 1 ? "s" : "") · @Model.Sum(c => c.Price * c.Quantity).ToString("F2") € total</p>

      <div class="cart-list">
        @foreach (var item in Model)
        {
          <div class="cart-row" id="row-@item.Id" onclick="openProductPanel('@item.Market', '@item.Name.Replace("'", "\\'")','@item.Image')" style="cursor:pointer">            @if (!string.IsNullOrEmpty(item.Image))
            {
              <img class="cart-img" src="@item.Image" alt="@item.Name" onerror="this.style.display='none'">
            }
            else
            {
              <div class="cart-img-placeholder">🛒</div>
            }
            <div class="cart-info">
              <div class="cart-market">@item.Market</div>
              <div class="cart-name" title="@item.Name">@item.Name</div>
              @if (!string.IsNullOrEmpty(item.PriceUnitOrKg))
              {
                <div class="cart-unit">@item.PriceUnitOrKg</div>
              }
            </div>
            <div class="qty-wrap">
              <button class="qty-btn" onclick="changeQty(@item.Id, @item.Quantity, -1)">−</button>
              <span class="qty-val" id="qty-@item.Id">@item.Quantity</span>
              <button class="qty-btn" onclick="changeQty(@item.Id, @item.Quantity, 1)">+</button>
            </div>
            <div class="cart-price" id="price-@item.Id">@((item.Price * item.Quantity).ToString("F2")) €</div>
            <form method="post" asp-action="Delete" asp-controller="Cart" style="margin:0">
              @Html.AntiForgeryToken()
              <input type="hidden" name="id" value="@item.Id" />
              <button type="submit" class="btn-delete">✕</button>
            </form>
          </div>
        }
      </div>

      <div class="summary">
        <div class="summary-title">Resumen</div>
        @foreach (var group in Model.GroupBy(c => c.Market))
        {
          <div class="summary-row">
            <span>@group.Key</span>
            <span>@group.Sum(c => c.Price * c.Quantity).ToString("F2") €</span>
          </div>
        }
        <div class="summary-total">
          <span>Total</span>
          <span id="totalPrice">@Model.Sum(c => c.Price * c.Quantity).ToString("F2") €</span>
        </div>
        <form method="post" asp-action="Clear" asp-controller="Cart" style="margin:0">
          @Html.AntiForgeryToken()
          <button type="submit" class="btn-clear" onclick="return confirm('¿Vaciar toda la lista?')">🗑 Vaciar lista</button>
        </form>
        @if (Model.Any())
        {
          <button class="btn-route" onclick="openCartRouteModal()">
            🗺️ Ver ruta óptima de compra
          </button>
        }
      </div>
    }
  </div>

  <!-- MODAL RUTA CARRITO -->
  <div id="cartRouteModal">
    <div class="route-modal-box">
      <div class="route-modal-header">
        <h2>🗺️ Ruta óptima — Tu lista de la compra</h2>
        <button onclick="closeCartRouteModal()" style="background:none;border:none;color:var(--text-dim);font-size:1.2rem;cursor:pointer;">✕</button>
      </div>
      <div id="cartRouteMap"></div>
      <div id="cartRouteStatus">Obteniendo tu ubicación...</div>
      <div id="cartRouteInfo"></div>
      <div class="cart-route-summary" id="cartRouteSummary" style="display:none;">
        <div><span>Distancia total:</span><strong id="cartRouteDist">—</strong></div>
        <div><span>Tiempo estimado:</span><strong id="cartRouteTime">—</strong></div>
        <div><span>Paradas:</span><strong id="cartRouteStops">—</strong></div>
      </div>
    </div>
  </div>

    <!-- PRODUCT PANEL DRAWER -->
    <div class="product-panel" id="productPanel">
      <div class="panel-backdrop" onclick="closeProductPanel()"></div>
      <div class="panel-drawer">
        <div class="panel-header">
          <button class="panel-close" onclick="closeProductPanel()">✕</button>
          <div class="panel-title" id="panelTitle"></div>
        </div>
        <div class="panel-body" id="panelBody">
          <div class="panel-spinner"></div>
        </div>
      </div>
    </div>

  <script>
    // Markets del carrito (desde servidor)
    const cartMarkets = @Html.Raw(
      System.Text.Json.JsonSerializer.Serialize(
        Model.Select(c => c.Market).Distinct().ToList()
      )
    );

    const darkMapStyle = [
      { elementType:'geometry', stylers:[{color:'#1a1a1c'}] },
      { elementType:'labels.text.fill', stylers:[{color:'#888884'}] },
      { elementType:'labels.text.stroke', stylers:[{color:'#0e0e0f'}] },
      { featureType:'road', elementType:'geometry', stylers:[{color:'#2e2e33'}] },
      { featureType:'road.highway', elementType:'geometry', stylers:[{color:'#3a3a40'}] },
      { featureType:'water', elementType:'geometry', stylers:[{color:'#0e0e0f'}] },
      { featureType:'poi', stylers:[{visibility:'off'}] },
      { featureType:'transit', stylers:[{visibility:'off'}] },
    ];

    let cMap = null, cDirSvc = null, cDirRend = null, cGeocoder = null;
    let cUserLatLng = null, cCustomMarkers = [];

    function initCartMaps() {}

    function openCartRouteModal() {
      document.getElementById('cartRouteModal').classList.add('open');
      document.body.style.overflow = 'hidden';
      document.getElementById('cartRouteStatus').style.display = 'block';
      document.getElementById('cartRouteStatus').textContent = 'Obteniendo tu ubicación...';
      document.getElementById('cartRouteInfo').innerHTML = '';
      document.getElementById('cartRouteSummary').style.display = 'none';

      if (!navigator.geolocation) {
        document.getElementById('cartRouteStatus').textContent = 'Tu navegador no soporta geolocalización.';
        return;
      }
      navigator.geolocation.getCurrentPosition(onCartGotPosition, () => {
        document.getElementById('cartRouteStatus').textContent = 'No se pudo obtener la ubicación.';
      }, { timeout: 10000 });
    }

    function closeCartRouteModal() {
      document.getElementById('cartRouteModal').classList.remove('open');
      document.body.style.overflow = '';
    }

    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeCartRouteModal(); });

    function clearCartMarkers() {
      cCustomMarkers.forEach(m => m.setMap(null));
      cCustomMarkers = [];
    }

    async function onCartGotPosition(pos) {
      cUserLatLng = { lat: pos.coords.latitude, lng: pos.coords.longitude };

      if (!cMap) {
        cMap = new google.maps.Map(document.getElementById('cartRouteMap'), {
          center: cUserLatLng, zoom: 13, styles: darkMapStyle, zoomControl: true,
        });
        cDirSvc = new google.maps.DirectionsService();
        cDirRend = new google.maps.DirectionsRenderer({
          suppressMarkers: true,
          polylineOptions: { strokeColor: '#FF6B35', strokeWeight: 5, strokeOpacity: 0.9 }
        });
        cDirRend.setMap(cMap);
        cGeocoder = new google.maps.Geocoder();
      } else {
        cMap.setCenter(cUserLatLng);
        clearCartMarkers();
        cDirRend.set('directions', null);
      }

      // Marcador usuario
      const um = new google.maps.Marker({
        position: cUserLatLng, map: cMap, title: 'Tu ubicación', zIndex: 100,
        icon: { path: google.maps.SymbolPath.CIRCLE, scale: 12, fillColor: '#2EC4B6', fillOpacity: 1, strokeColor: '#fff', strokeWeight: 3 },
        label: { text: '⌂', color: '#ffffff', fontSize: '13px', fontWeight: 'bold' }
      });
      cCustomMarkers.push(um);

      document.getElementById('cartRouteStatus').textContent = `Buscando ${cartMarkets.join(', ')}...`;

      // Geocodificar ciudad una vez
      const city = await new Promise(resolve => {
        cGeocoder.geocode({ location: cUserLatLng }, (res, st) => {
          if (st === 'OK' && res.length > 0) {
            const comp = res[0].address_components.find(c => c.types.includes('locality'));
            resolve(comp ? comp.long_name : '');
          } else resolve('');
        });
      });

      // Geocodificar cada supermercado
      const waypoints = [];
      for (const market of cartMarkets) {
        const wp = await findMarket(market, city);
        if (wp) waypoints.push(wp);
      }

      if (waypoints.length === 0) {
        document.getElementById('cartRouteStatus').textContent = 'No se encontraron supermercados cercanos.';
        return;
      }

      document.getElementById('cartRouteStatus').textContent = 'Calculando ruta óptima...';
      buildCartOptimalRoute(waypoints);
    }

    async function findMarket(marketName, city) {
      try {
        const center = cMap.getCenter();
        const { Place } = await google.maps.importLibrary('places');
        const { places } = await Place.searchByText({
          textQuery: `${marketName} supermercado`,
          fields: ['displayName', 'location', 'formattedAddress'],
          locationBias: { center, radius: 8000 },
          maxResultCount: 1,
        });
        if (places && places.length > 0) {
          return { name: marketName, latLng: places[0].location, address: places[0].formattedAddress };
        }
      } catch(e) {}

      return new Promise(resolve => {
        const query = city ? `${marketName} ${city}` : marketName;
        cGeocoder.geocode({ address: query }, (res, st) => {
          if (st === 'OK' && res.length > 0) {
            resolve({ name: marketName, latLng: res[0].geometry.location, address: res[0].formatted_address });
          } else resolve(null);
        });
      });
    }

    function buildCartOptimalRoute(waypoints) {
      cDirSvc.route({
        origin: cUserLatLng,
        destination: cUserLatLng,
        waypoints: waypoints.map(w => ({ location: w.latLng, stopover: true })),
        optimizeWaypoints: true,
        travelMode: google.maps.TravelMode.DRIVING
      }, (result, status) => {
        if (status === 'OK') {
          cDirRend.setDirections(result);
          renderCartRoute(result, waypoints);
        } else {
          document.getElementById('cartRouteStatus').textContent = `Error: ${status}`;
        }
      });
    }

    let cOpenInfoWindow = null;

    function renderCartRoute(result, waypoints) {
      const route = result.routes[0];
      const order = route.waypoint_order;  // orden optimizado de visita
      const legs = route.legs;
      const colors = ['#FF6B35','#FFD166','#2EC4B6','#a78bfa','#f472b6','#34d399','#60a5fa','#fb923c'];

      let totalDist = 0, totalTime = 0;
      legs.forEach(l => { totalDist += l.distance.value; totalTime += l.duration.value; });

      document.getElementById('cartRouteDist').textContent = (totalDist / 1000).toFixed(1) + ' km';
      document.getElementById('cartRouteTime').textContent = Math.round(totalTime / 60) + ' min';
      document.getElementById('cartRouteStops').textContent = waypoints.length + ' supermercado' + (waypoints.length !== 1 ? 's' : '');
      document.getElementById('cartRouteSummary').style.display = 'flex';
      document.getElementById('cartRouteStatus').style.display = 'none';

      // orderedStops[0] = primera parada, [1] = segunda, etc.
      const orderedStops = order.map(i => waypoints[i]);

      // Marcadores numerados según orden de visita + InfoWindow al clic
      orderedStops.forEach((stop, visitIdx) => {
        const color = colors[visitIdx % colors.length];
        const marker = new google.maps.Marker({
          position: stop.latLng, map: cMap, zIndex: 50,
          icon: { path: google.maps.SymbolPath.CIRCLE, scale: 16, fillColor: color, fillOpacity: 1, strokeColor: '#fff', strokeWeight: 2.5 },
          label: { text: String(visitIdx + 1), color: '#000', fontSize: '11px', fontWeight: 'bold' }
        });

        const leg = legs[visitIdx];
        const iw = new google.maps.InfoWindow({
          content: `<div style="font-family:'DM Sans',sans-serif;padding:8px 6px;min-width:170px;background:#1A1A1C;border-radius:10px;border:1.5px solid rgba(255,255,255,0.15);">
            <div style="font-size:12px;color:#888884;margin-bottom:2px;">Parada ${visitIdx + 1}</div>
            <strong style="font-size:14px;color:#F0EEE8;">${stop.name}</strong>
            <div style="font-size:11px;color:#888884;margin-top:4px;line-height:1.4;">${stop.address || ''}</div>
            <div style="margin-top:6px;font-size:12px;color:#FF6B35;font-weight:600;">${leg.distance.text} · ${leg.duration.text}</div>
          </div>`
        });

        marker.addListener('click', () => {
          if (cOpenInfoWindow) cOpenInfoWindow.close();
          iw.open(cMap, marker);
          cOpenInfoWindow = iw;
        });

        cCustomMarkers.push(marker);
      });

      // Lista de paradas con scroll
      let html = `<div class="route-step">
        <div class="route-step-num" style="background:var(--teal);">⌂</div>
        <div><strong>Tu ubicación</strong> <span style="color:var(--text-dim);font-size:0.78rem;">punto de partida</span></div>
      </div>`;

      orderedStops.forEach((stop, visitIdx) => {
        const leg = legs[visitIdx];
        const color = colors[visitIdx % colors.length];
        html += `<div class="route-step">
          <div class="route-step-num" style="background:${color};color:#000;">${visitIdx + 1}</div>
          <div>
            <strong>${stop.name}</strong>
            <span style="color:var(--text-dim);margin-left:6px;font-size:0.78rem;">${leg.distance.text} · ${leg.duration.text}</span>
            ${stop.address ? `<div style="color:var(--text-muted);font-size:0.75rem;margin-top:2px;">${stop.address}</div>` : ''}
          </div>
        </div>`;
      });

      const last = legs[legs.length - 1];
      html += `<div class="route-step">
        <div class="route-step-num" style="background:var(--teal);">⌂</div>
        <div><strong>Volver a casa</strong><span style="color:var(--text-dim);font-size:0.78rem;margin-left:6px;">${last.distance.text} · ${last.duration.text}</span></div>
      </div>`;

      document.getElementById('cartRouteInfo').innerHTML = html;
    }

    async function changeQty(id, current, delta) {
      const newQty = current + delta;
      if (newQty < 1) return;

      const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
      await fetch('/Cart/UpdateQuantity', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
        body: `id=${id}&quantity=${newQty}`
      });

      document.getElementById(`qty-${id}`).textContent = newQty;
      const priceEl = document.getElementById(`price-${id}`);
      const unitPrice = parseFloat(priceEl.dataset.unit);
      if (!isNaN(unitPrice)) {
        priceEl.textContent = (unitPrice * newQty).toFixed(2) + ' €';
        priceEl.dataset.qty = newQty;
      }
      location.reload();
    }

    // ── THEME TOGGLE ──
    (function() {
      const saved = localStorage.getItem('sc-theme') || 'dark';
      document.documentElement.setAttribute('data-theme', saved);
      const btn = document.getElementById('themeBtn');
      if (btn) btn.textContent = saved === 'dark' ? '☀️' : '🌙';
    })();

    function toggleTheme() {
      const cur  = document.documentElement.getAttribute('data-theme') || 'dark';
      const next = cur === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('sc-theme', next);
      document.getElementById('themeBtn').textContent = next === 'dark' ? '☀️' : '🌙';
    }

    // ── PRODUCT PANEL ──
    const isAuth = @(User.Identity != null && User.Identity.IsAuthenticated ? "true" : "false");
    let panelStars = 0;
    let panelProduct = null;

    async function openProductPanel(market, name, image) {
      panelProduct = { market, name, image };
      panelStars = 0;
      document.getElementById('panelTitle').textContent = name;
      document.getElementById('panelBody').innerHTML = '<div class="panel-spinner"></div>';
      document.getElementById('productPanel').classList.add('open');
      document.body.style.overflow = 'hidden';

      const res = await fetch(`/Review/GetProductReviews?market=${encodeURIComponent(market)}&productName=${encodeURIComponent(name)}`);
      const data = await res.json();
      renderPanelContent(data, market, name, image);
    }

    function closeProductPanel() {
      document.getElementById('productPanel').classList.remove('open');
      document.body.style.overflow = '';
    }

    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeProductPanel(); });

    function renderPanelContent(data, market, name, image) {
      const avg = data.avgRating || 0;
      const reviews = data.reviews || [];
      const myReview = data.myReview;
      if (myReview) panelStars = myReview.estrellas;

      const dist = [0,0,0,0,0];
      reviews.forEach(r => { if (r.estrellas >= 1 && r.estrellas <= 5) dist[r.estrellas-1]++; });
      const total = reviews.length;

      let avgStarsHtml = '';
      for (let i = 1; i <= 5; i++) {
        avgStarsHtml += avg >= i
          ? '<span class="pstar filled">⭐</span>'
          : '<span class="pstar">⭐</span>';
      }

      let distHtml = '';
      for (let s = 5; s >= 1; s--) {
        const cnt = dist[s-1];
        const pct = total > 0 ? Math.round(cnt / total * 100) : 0;
        distHtml += `<div class="panel-dist-row">
          <span style="min-width:12px">${s}</span>
          <span style="color:#FFD166;font-size:0.72rem">⭐</span>
          <div class="panel-bar-wrap"><div class="panel-bar-fill" style="width:${pct}%"></div></div>
          <span style="min-width:16px;text-align:right">${cnt}</span>
        </div>`;
      }

      const formHtml = isAuth
        ? `<div>
            <div class="panel-form-title">⭐ Tu valoración</div>
            <div class="panel-star-picker" id="panelStarPicker">
              ${[1,2,3,4,5].map(v => `<span class="panel-star${panelStars >= v ? ' filled' : ''}" data-val="${v}">⭐</span>`).join('')}
            </div>
            <textarea class="panel-textarea" id="panelComment" placeholder="Escribe tu comentario (opcional)...">${myReview?.comentario ?? ''}</textarea>
            <div class="panel-success" id="panelSuccess">✅ ¡Reseña guardada!</div>
            <button class="panel-btn-submit" id="panelBtnSubmit" onclick="submitPanelReview()" ${panelStars === 0 ? 'disabled' : ''}>Guardar reseña</button>
          </div>`
        : `<div class="panel-auth-prompt">
            <a href="/Account/Login">Inicia sesión</a> para dejar tu valoración.
          </div>`;

      const reviewsHtml = total === 0
        ? '<div class="panel-no-reviews">Sin reseñas aún — ¡sé el primero!</div>'
        : reviews.map(r => `
            <div class="panel-review">
              <div class="panel-review-header">
                <div class="panel-avatar">${(r.userEmail?.[0] ?? '?').toUpperCase()}</div>
                <div style="flex:1">
                  <div class="panel-reviewer-email">${r.userEmail}</div>
                  <div class="panel-reviewer-date">${new Date(r.creadaEn).toLocaleDateString('es-ES')}</div>
                </div>
                <div class="panel-review-stars">
                  ${[1,2,3,4,5].map(s => `<span class="prstar${s <= r.estrellas ? ' filled' : ''}">⭐</span>`).join('')}
                </div>
              </div>
              ${r.comentario ? `<div class="panel-review-comment">${r.comentario}</div>` : ''}
            </div>`).join('');

      document.getElementById('panelBody').innerHTML = `
        <div class="panel-product-top">
          <div class="panel-img-wrap">
            ${image ? `<img src="${image}" alt="${name}" onerror="this.parentElement.innerHTML='🛒'">` : '🛒'}
          </div>
          <div class="panel-product-info">
            <div class="panel-market">${market}</div>
            <div class="panel-name">${name}</div>
          </div>
        </div>
        ${total > 0 ? `
        <div class="panel-avg">
          <div class="panel-avg-big">${avg.toFixed(1)}</div>
          <div class="panel-avg-right">
            <div class="panel-stars">${avgStarsHtml}</div>
            <div class="panel-count">${total} reseña${total !== 1 ? 's' : ''}</div>
          </div>
        </div>
        <div class="panel-dist">${distHtml}</div>
        ` : '<div style="color:var(--text-muted);font-size:0.85rem;font-style:italic">Sin valoraciones aún</div>'}
        ${formHtml}
        <div style="font-family:'Syne',sans-serif;font-size:0.9rem;font-weight:700;">
          💬 Reseñas <span style="background:var(--bg3);border:1px solid var(--border);border-radius:6px;padding:0.1rem 0.45rem;font-size:0.7rem;color:var(--text-muted);font-weight:400;font-family:'DM Sans',sans-serif;">${total}</span>
        </div>
        <div>${reviewsHtml}</div>
      `;

      document.querySelectorAll('.panel-star').forEach(s => {
        s.addEventListener('click', () => { panelStars = parseInt(s.dataset.val); updatePanelStars(panelStars); });
        s.addEventListener('mouseover', () => updatePanelStars(parseInt(s.dataset.val)));
        s.addEventListener('mouseout', () => updatePanelStars(panelStars));
      });
    }

    function updatePanelStars(val) {
      document.querySelectorAll('.panel-star').forEach(s =>
        s.classList.toggle('filled', parseInt(s.dataset.val) <= val));
      const btn = document.getElementById('panelBtnSubmit');
      if (btn) btn.disabled = val === 0;
    }

    async function submitPanelReview() {
      if (!isAuth || panelStars === 0 || !panelProduct) return;
      const comentario = document.getElementById('panelComment').value;
      const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
      const res = await fetch('/Review/Create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
        body: `market=${encodeURIComponent(panelProduct.market)}&productName=${encodeURIComponent(panelProduct.name)}&productImage=${encodeURIComponent(panelProduct.image)}&estrellas=${panelStars}&comentario=${encodeURIComponent(comentario)}`
      });
      const data = await res.json();
      if (data.success) {
        document.getElementById('panelSuccess').style.display = 'block';
        setTimeout(() => openProductPanel(panelProduct.market, panelProduct.name, panelProduct.image), 1200);
      }
    }
  </script>
  @Html.AntiForgeryToken()
</body>
</html>
