@model SuperCartMVC.Models.LoginViewModel
@{ Layout = null; }

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login — SuperCart</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel href="/.png">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
  <style>
    :root {
      --orange: #FF6B35; --orange-dark: #D94F1A; --yellow: #FFD166; --teal: #2EC4B6;
      --bg: #13151C; --bg2: #1E2130; --bg3: #272C3E; --border: #363C54;
      --text: #F0EDE8; --text-dim: #9BA3BE; --text-muted: #717899;
      --header-bg: rgba(19,21,28,0.93); --shadow: 0 2px 16px rgba(0,0,0,0.45);
    }
    html[data-theme="light"] {
      --orange: #D4510A; --orange-dark: #B53D05; --yellow: #8F6B00; --teal: #0E8A84;
      --bg: #F4F6FB; --bg2: #FFFFFF; --bg3: #ECEEF7; --border: #CDD1E8;
      --text: #1A1D2E; --text-dim: #444968; --text-muted: #6B7299;
      --header-bg: rgba(255,255,255,0.93); --shadow: 0 2px 16px rgba(0,0,0,0.10);
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'DM Sans', sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .logo-text {
      font-family: 'Syne', sans-serif;
      font-size: 1.6rem;
      font-weight: 800;
      color: var(--orange);
      margin-bottom: 2rem;
      letter-spacing: -0.5px;
    }
    .logo-text span { color: var(--text); }
    .card {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 2rem;
      width: 100%;
      max-width: 400px;
    }
    h2 {
      font-family: 'Syne', sans-serif;
      font-size: 1.4rem;
      font-weight: 700;
      margin-bottom: 0.4rem;
    }
    .subtitle {
      color: var(--text-dim);
      font-size: 0.88rem;
      margin-bottom: 1.8rem;
    }
    .field { margin-bottom: 1.2rem; }
    label {
      display: block;
      font-size: 0.8rem;
      color: var(--text-dim);
      margin-bottom: 0.4rem;
      text-transform: uppercase;
      letter-spacing: 0.8px;
    }
    input {
      width: 100%;
      background: var(--bg3);
      border: 1.5px solid var(--border);
      border-radius: 10px;
      padding: 0.7rem 1rem;
      color: var(--text);
      font-family: 'DM Sans', sans-serif;
      font-size: 0.95rem;
      outline: none;
      transition: border-color 0.2s;
    }
    input:focus { border-color: var(--orange); }
    .remember {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.85rem;
      color: var(--text-dim);
      margin-bottom: 1.5rem;
    }
    .remember input { width: auto; }
    .btn {
      width: 100%;
      background: var(--orange);
      color: white;
      border: none;
      border-radius: 10px;
      padding: 0.75rem;
      font-family: 'Syne', sans-serif;
      font-weight: 700;
      font-size: 0.95rem;
      cursor: pointer;
      transition: background 0.15s;
    }
    .btn:hover { background: var(--orange-dark); }
    .errors {
      background: rgba(255,107,53,0.1);
      border: 1px solid rgba(255,107,53,0.3);
      border-radius: 8px;
      padding: 0.7rem 1rem;
      margin-bottom: 1.2rem;
      font-size: 0.85rem;
      color: var(--orange);
    }
    .footer-link {
      text-align: center;
      margin-top: 1.2rem;
      font-size: 0.85rem;
      color: var(--text-dim);
    }
    .footer-link a { color: var(--teal); text-decoration: none; }
    .footer-link a:hover { text-decoration: underline; }

    /* Mobile */
    @@media (max-width: 480px) {
      body { justify-content: flex-start; padding: 2rem 0; }
      .card { border-radius: 0; border-left: none; border-right: none; max-width: 100%; }
      .logo-text { font-size: 1.4rem; margin-bottom: 1.5rem; }
    }
    
  </style>
</head>
<body>
  <div class="logo-text">Super<span>Cart</span></div>

  <div class="card">
    <h2>Bienvenido de nuevo</h2>
    <p class="subtitle">Inicia sesión para ver tus favoritos y reseñas</p>

    @if (TempData["ResetSuccess"] != null)
    {
      <div style="background:rgba(46,196,182,0.1);border:1px solid rgba(46,196,182,0.3);border-radius:8px;padding:0.7rem 1rem;margin-bottom:1.2rem;font-size:0.85rem;color:#2EC4B6;">
        @TempData["ResetSuccess"]
      </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
      <div class="errors">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
          <div>@error.ErrorMessage</div>
        }
      </div>
    }

    <form method="post" asp-action="Login" asp-controller="Account">
      @Html.AntiForgeryToken()

      <div class="field">
        <label>Email</label>
        <input type="email" asp-for="Email" placeholder="tu@email.com" />
      </div>

      <div class="field">
        <label>Contraseña</label>
        <input type="password" asp-for="Password" placeholder="••••••••" />
      </div>

      <div class="remember">
        <input type="checkbox" asp-for="RememberMe" />
        <span>Recordarme</span>
      </div>

      <button type="submit" class="btn">Entrar</button>
    </form>

    <div class="footer-link" style="margin-top:0.8rem;">
      <a href="/Account/ForgotPassword" style="color:var(--text-muted);font-size:0.82rem;">¿Olvidaste tu contraseña?</a>
    </div>
    <div class="footer-link">
      ¿No tienes cuenta? <a href="/Account/Register">Regístrate</a>
    </div>
  </div>
</body>
</html>