@model List<SuperCartMVC.Models.Favorito>
@{ Layout = null; }

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mis Favoritos — SuperCart</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
  <style>
  :root {
    --orange: #FF6B35; --orange-dark: #D94F1A; --yellow: #FFD166; --teal: #2EC4B6;
    --bg: #13151C; --bg2: #1E2130; --bg3: #272C3E; --border: #363C54;
    --text: #F0EDE8; --text-dim: #9BA3BE; --text-muted: #717899;
    --header-bg: rgba(19,21,28,0.93); --shadow: 0 2px 16px rgba(0,0,0,0.45);
  }
  html[data-theme="light"] {
    --orange: #D4510A; --orange-dark: #B53D05; --yellow: #8F6B00; --teal: #0E8A84;
    --bg: #F4F6FB; --bg2: #FFFFFF; --bg3: #ECEEF7; --border: #CDD1E8;
    --text: #1A1D2E; --text-dim: #444968; --text-muted: #6B7299;
    --header-bg: rgba(255,255,255,0.93); --shadow: 0 2px 16px rgba(0,0,0,0.10);
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: var(--bg); color: var(--text); font-family: 'DM Sans', sans-serif; min-height: 100vh; }
  header {
    padding: 1.5rem 2rem; display: flex; align-items: center; gap: 1rem;
    border-bottom: 1px solid var(--border); position: sticky; top: 0;
    background: var(--header-bg); backdrop-filter: blur(12px); z-index: 100;
  }
  .logo-icon { width: 36px; height: 36px; flex-shrink: 0; }
  .logo-text { font-family: 'Syne', sans-serif; font-size: 1.4rem; font-weight: 800; color: var(--orange); }
  .logo-text span { color: var(--text); }
  .header-right { margin-left: auto; display: flex; gap: 0.6rem; align-items: center; }
  .theme-btn { background: var(--bg3); border: 1px solid var(--border); border-radius: 8px; padding: 0.35rem 0.55rem; font-size: 1rem; cursor: pointer; line-height: 1; transition: background 0.2s; flex-shrink: 0; }
  .theme-btn:hover { background: var(--border); }
  .btn-back { background: transparent; border: 1px solid var(--border); border-radius: 10px; padding: 0.45rem 0.85rem; color: var(--text-dim); font-family: 'DM Sans', sans-serif; font-size: 0.83rem; cursor: pointer; text-decoration: none; transition: border-color 0.2s; white-space: nowrap; }
  .btn-back:hover { border-color: var(--orange); color: var(--text); }
  .page { max-width: 980px; margin: 0 auto; padding: 1.5rem 0.75rem 4rem; }
  h1 { font-family: 'Syne', sans-serif; font-size: 1.6rem; font-weight: 800; margin-bottom: 0.3rem; }
  .subtitle { color: var(--text-dim); font-size: 0.88rem; margin-bottom: 1.5rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 0.75rem; }
  .card { background: var(--bg2); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; display: flex; flex-direction: column; transition: border-color 0.2s, transform 0.15s; }
  .card:hover { border-color: var(--orange); transform: translateY(-2px); }
  .card-img { width: 100%; aspect-ratio: 1; object-fit: contain; background: #fff; padding: 0.7rem; }
  .card-img-placeholder { width: 100%; aspect-ratio: 1; background: var(--bg3); display: flex; align-items: center; justify-content: center; font-size: 2rem; }
  .card-body { padding: 0.8rem; flex: 1; display: flex; flex-direction: column; gap: 0.35rem; }
  .card-market { font-size: 0.64rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; color: var(--teal); }
  .card-name { font-size: 0.84rem; color: var(--text); line-height: 1.35; flex: 1; }
  .card-footer { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 0.4rem; flex-wrap: wrap; gap: 0.3rem; }
  .card-price { font-family: 'Syne', sans-serif; font-size: 1.15rem; font-weight: 700; color: var(--orange); }
  .btn-delete { background: transparent; border: 1px solid var(--border); border-radius: 8px; padding: 0.28rem 0.55rem; color: var(--text-muted); font-size: 0.78rem; cursor: pointer; transition: all 0.15s; }
  .btn-delete:hover { border-color: #e24b4a; color: #e24b4a; }
  .empty { text-align: center; padding: 3.5rem 1rem; color: var(--text-muted); }
  .empty .icon { font-size: 2.5rem; margin-bottom: 0.8rem; }
  .empty h3 { font-family: 'Syne', sans-serif; font-size: 1.1rem; color: var(--text-dim); margin-bottom: 0.35rem; }
  .added-at { font-size: 0.68rem; color: var(--text-muted); margin-top: 0.2rem; }
  .tabs { display: flex; gap: 0.5rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
  .tab-btn { background: var(--bg2); border: 1.5px solid var(--border); border-radius: 10px; padding: 0.45rem 1.1rem; color: var(--text-dim); font-family: 'DM Sans', sans-serif; font-size: 0.85rem; cursor: pointer; transition: all 0.15s; }
  .tab-btn.active { background: var(--orange); border-color: var(--orange); color: white; font-weight: 600; }
  .tab-btn:hover:not(.active) { border-color: var(--orange); color: var(--text); }
  .review-card { background: var(--bg2); border: 1px solid var(--border); border-radius: 14px; padding: 1rem 1.1rem; display: flex; flex-direction: column; gap: 0.45rem; transition: border-color 0.2s; }
  .review-card:hover { border-color: var(--teal); }
  .review-market { font-size: 0.64rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; color: var(--teal); }
  .review-name { font-size: 0.85rem; color: var(--text); line-height: 1.35; }
  .review-stars { color: #FFD166; font-size: 0.95rem; letter-spacing: 2px; }
  .review-comment { font-size: 0.81rem; color: var(--text-dim); font-style: italic; }
  .review-date { font-size: 0.68rem; color: var(--text-muted); }
  .review-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 0.85rem; }

  @@media (max-width: 480px) {
    header { padding: 0.65rem 0.75rem; }
    .logo-text { font-size: 1.05rem; }
    h1 { font-size: 1.35rem; }
    .grid { grid-template-columns: repeat(2, 1fr); gap: 0.5rem; }
    .review-grid { grid-template-columns: 1fr; }
    .btn-back { font-size: 0.78rem; padding: 0.4rem 0.65rem; }
  }
</style>
</head>
<body>
  <header>
    <svg class="logo-icon" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M4 10 Q4 5 9 5 L15 5 L15 14" stroke="#FF6B35" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      <rect x="6" y="14" width="30" height="19" rx="5" fill="#FF6B35"/>
      <line x1="6" y1="24" x2="36" y2="24" stroke="rgba(255,255,255,0.18)" stroke-width="1"/>
      <circle cx="37" cy="8" r="7.5" fill="#2EC4B6"/>
      <text x="37" y="12" font-family="sans-serif" font-size="9" font-weight="700" fill="white" text-anchor="middle">€</text>
      <circle cx="14" cy="38.5" r="4.5" fill="#2EC4B6"/>
      <circle cx="14" cy="38.5" r="2" fill="white" opacity=".85"/>
      <circle cx="29" cy="38.5" r="4.5" fill="#2EC4B6"/>
      <circle cx="29" cy="38.5" r="2" fill="white" opacity=".85"/>
    </svg>
    <div class="logo-text">Super<span>Cart</span></div>
    <div class="header-right">
      <button id="themeBtn" class="theme-btn" onclick="toggleTheme()" title="Cambiar tema">☀️</button>
      <a href="/" class="btn-back">← Volver al comparador</a>
    </div>
  </header>

  <div class="page">
  <h1>Mi perfil</h1>

  <div class="tabs">
    <button class="tab-btn active" onclick="showTab('favoritos')">❤️ Mis favoritos</button>
    <button class="tab-btn" onclick="showTab('reviews')">⭐ Mis reseñas</button>
  </div>

  <!-- TAB FAVORITOS -->
  <div id="tab-favoritos">
    <p class="subtitle">@Model.Count producto@(Model.Count != 1 ? "s" : "") guardado@(Model.Count != 1 ? "s" : "")</p>
    @if (!Model.Any())
    {
      <div class="empty">
        <div class="icon">🤍</div>
        <h3>Aún no tienes favoritos</h3>
        <p>Busca productos y pulsa el corazón para guardarlos aquí.</p>
      </div>
    }
    else
    {
      <div class="grid">
        @foreach (var fav in Model)
        {
          <div class="card">
            @if (!string.IsNullOrEmpty(fav.Image))
            {
              <img class="card-img" src="@fav.Image" alt="@fav.Name" onerror="this.style.display='none'">
            }
            else
            {
              <div class="card-img-placeholder">🛒</div>
            }
            <div class="card-body">
              <div class="card-market">@fav.Market</div>
              <div class="card-name">@fav.Name</div>
              <div class="card-footer">
                <div class="card-price">@fav.Price.ToString("F2") €</div>
                <form method="post" asp-action="Delete" asp-controller="Favorito" style="margin:0">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="id" value="@fav.Id" />
                  <button type="submit" class="btn-delete">✕ Quitar</button>
                </form>
              </div>
              <div class="added-at">Añadido @fav.AddedAt.ToString("dd/MM/yyyy")</div>
            </div>
          </div>
        }
      </div>
    }
  </div>

  <!-- TAB REVIEWS -->
  <div id="tab-reviews" style="display:none">
    <p class="subtitle" id="reviews-subtitle">Cargando reseñas...</p>
    <div class="review-grid" id="reviews-grid"></div>
    <div class="empty" id="reviews-empty" style="display:none">
      <div class="icon">⭐</div>
      <h3>Aún no has hecho reseñas</h3>
      <p>Busca productos y pulsa 💬 para dejar tu opinión.</p>
    </div>
  </div>
</div>

<script>
  // ── THEME TOGGLE ──
  (function() {
    const saved = localStorage.getItem('sc-theme') || 'dark';
    document.documentElement.setAttribute('data-theme', saved);
    const btn = document.getElementById('themeBtn');
    if (btn) btn.textContent = saved === 'dark' ? '☀️' : '🌙';
  })();

  function toggleTheme() {
    const cur  = document.documentElement.getAttribute('data-theme') || 'dark';
    const next = cur === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('sc-theme', next);
    document.getElementById('themeBtn').textContent = next === 'dark' ? '☀️' : '🌙';
  }

  let reviewsLoaded = false;

  function showTab(tab) {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('tab-favoritos').style.display = tab === 'favoritos' ? '' : 'none';
    document.getElementById('tab-reviews').style.display  = tab === 'reviews'   ? '' : 'none';
    event.target.classList.add('active');

    if (tab === 'reviews' && !reviewsLoaded) loadReviews();
  }

  async function loadReviews() {
    const res = await fetch('/Review/MisReviews');
    const reviews = await res.json();
    reviewsLoaded = true;

    const subtitle = document.getElementById('reviews-subtitle');
    const grid = document.getElementById('reviews-grid');
    const empty = document.getElementById('reviews-empty');

    if (reviews.length === 0) {
      subtitle.style.display = 'none';
      empty.style.display = 'block';
      return;
    }

    subtitle.textContent = `${reviews.length} reseña${reviews.length !== 1 ? 's' : ''}`;
    grid.innerHTML = reviews.map(r => `
      <div class="review-card">
        <div class="review-market">${r.market}</div>
        <div class="review-name">${r.productName}</div>
        <div class="review-stars">${'★'.repeat(r.estrellas)}${'☆'.repeat(5 - r.estrellas)}</div>
        ${r.comentario ? `<div class="review-comment">"${r.comentario}"</div>` : '<div class="review-comment" style="color:var(--text-muted)">Sin comentario</div>'}
        <div class="review-date">${new Date(r.creadaEn).toLocaleDateString('es-ES')}</div>
      </div>
    `).join('');
  }
</script>
</body>
</html>